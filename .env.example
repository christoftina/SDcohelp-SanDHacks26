# Copy this file to ".env" and paste your keys after the = signs.
# NEVER put the .env file on GitHub or share it in Discord.

# Google Gemini - get a key at https://aistudio.google.com  ("Get API key")
GEMINI_API_KEY=
# If you get a "model not found" error, copy the current Flash model name from AI Studio here.
GEMINI_MODEL=gemini-2.5-flash

# Bright Data - from the Bright Data dashboard
# API key: Account settings -> API keys.  Zone: the name of your Web Unlocker zone (e.g. web_unlocker1)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# ElevenLabs (optional - without it, the browser's built-in voice reads answers)
# API key: elevenlabs.io -> Developers -> API Keys.  Voice ID: open a voice -> "Copy voice ID".
ELEVENLABS_API_KEY=
# One voice per language. Leave a line empty to use the browser's voice for that language.
ELEVENLABS_VOICE_MANDARIN=
# Cantonese is empty on purpose: the browser's Hong Kong voice speaks real Cantonese,
# while most ElevenLabs voices would read the Chinese characters in Mandarin.
ELEVENLABS_VOICE_CANTONESE=
ELEVENLABS_VOICE_SPANISH=
ELEVENLABS_VOICE_TAGALOG=
ELEVENLABS_VOICE_ENGLISH=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Server settings (leave these alone)
HOST=127.0.0.1
PORT=8000
